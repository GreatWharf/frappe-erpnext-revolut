    },
    {
      "fieldname": "environment",
      "fieldtype": "Data",
      "label": "Environment",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "account_id",
      "fieldtype": "Data",
      "label": "Account Id",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "bank_account",
      "fieldtype": "Link",
      "label": "Bank Account",
      "options": "Bank Account",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
